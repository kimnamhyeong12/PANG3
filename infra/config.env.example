# 이 파일을 infra/config.env 로 복사한 뒤 값만 수정하세요.
# config.env 는 git에 올리지 마세요 (infra/.gitignore 참고)

AWS_REGION=ap-northeast-2

# S3 버킷 이름 (팀에서 정한 이름으로 변경)
S3_BUCKET_NAME=sahagu-fieldwork-prod

# SSM 파라미터 경로 (Gemini API 키)
SSM_GEMINI_PARAM=/sahagu/gemini/api-key

# EC2 프로젝트 경로 (deploy.yml 기준)
PROJECT_ROOT=/home/ubuntu/PANG3
