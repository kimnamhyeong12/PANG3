{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SahaguSsmReadGemini",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/sahagu/*"
    },
    {
      "Sid": "SahaguSsmDecrypt",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        }
      }
    }
  ]
}
