{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "App.js",
    "screens/**/*",
    "components/**/*",
    "constants/**/*",
    "utils/**/*",
    "services/**/*",
    "modules/**/*.js",
    "**/*.ts",
    "**/*.tsx"
  ]
}
